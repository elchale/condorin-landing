generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Someone who signed in with a verified WhatsApp number.
model Member {
  id           String   @id @default(cuid())
  /// Digits only, with country code, e.g. 51987654321.
  phone        String   @unique
  /// Last time the person accepted the terms and privacy policy (checked before every code).
  consentAt    DateTime
  lastSignInAt DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A Google account allowed into /admin. Signing in with Google proves who you are; a row here
/// with `active = true` is what grants access, checked on every request.
model Admin {
  id        String   @id @default(cuid())
  /// Lowercase, as Google returns it once verified.
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
