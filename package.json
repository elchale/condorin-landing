{
  "name": "condorin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "og": "node scripts/generate-og.mjs",
    "postinstall": "prisma generate",
