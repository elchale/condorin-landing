# Public URL of this admin app (https://admin.condorin.pe in production). First allowed OAuth origin
# and base for absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random 32+ byte secret that signs the /admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# Neon Postgres (pooled URL), the same database as the Django backend. Django runs the migrations.
DATABASE_URL=

# Google OAuth for the /admin panel (shared Qolca Solutions client, same as futurx.pe).
# The client needs these redirect URIs in the Google Cloud console:
#   https://admin.condorin.pe/api/admin/oauth/callback
#   https://www.condorin.pe/api/admin/oauth/callback   (legacy, while www still served this app)
#   https://condorin.pe/api/admin/oauth/callback       (legacy)
#   http://localhost:3000/api/admin/oauth/callback
# Access is granted by an active row in the Admin table, not by having a Google account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Django API (condorin-backend). Only this server calls it, for the /admin/en-vivo feed.
CONDORIN_API_URL=https://api.condorin.pe
# Same value as PANEL_API_SECRET in the backend. Generate it like OTP_SECRET.
PANEL_API_SECRET=
