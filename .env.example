# Public URL of the site. Used for absolute links in the WhatsApp/social preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random 32+ byte secret that signs the login codes and sessions (members and /admin).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# Neon Postgres. The app uses the pooled URL, migrations the direct one.
DATABASE_URL=
DIRECT_URL=

# WhatsApp Cloud API (Meta). The token needs whatsapp_business_messaging on this number.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=

# Approved AUTHENTICATION template with a copy-code button.
WA_TEMPLATE=condorin_codigo
WA_TEMPLATE_LANG=es

# Google OAuth for the /admin panel (shared Qolca Solutions client, same as futurx.pe).
# The client needs these redirect URIs in the Google Cloud console:
#   https://www.condorin.pe/api/admin/oauth/callback
#   https://condorin.pe/api/admin/oauth/callback
#   http://localhost:3000/api/admin/oauth/callback
# Access is granted by an active row in the Admin table, not by having a Google account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
