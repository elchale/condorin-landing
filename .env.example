# Public URL of the site. Used for absolute links in the WhatsApp/social preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random 32+ byte secret that signs the login codes and sessions (members and /admin).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=

# Neon Postgres (pooled URL), the same database as the Django backend. Django runs the migrations.
DATABASE_URL=

# WhatsApp Cloud API (Meta). The token needs whatsapp_business_messaging on this number.
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=

# Approved AUTHENTICATION template with a copy-code button.
WA_TEMPLATE=condorin_codigo
WA_TEMPLATE_LANG=es

# Google OAuth for the /admin panel (shared Qolca Solutions client, same as futurx.pe).
# The client needs these redirect URIs in the Google Cloud console:
#   https://www.condorin.pe/api/admin/oauth/callback
#   https://condorin.pe/api/admin/oauth/callback
#   http://localhost:3000/api/admin/oauth/callback
# Access is granted by an active row in the Admin table, not by having a Google account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Qolca SMTP (SendGrid) for the new-member email sent to every active admin.
# Only SMTP_PASS (the SendGrid API key) is required; the rest default to these values.
SMTP_PASS=
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# MAIL_FROM=Ojo de Cóndor <info@qolca.org>

# The Django API (condorin-backend). Only this server calls it: the panel, the link sign in and the
# /api/expedientes proxy the expediente page uses.
CONDORIN_API_URL=https://api.condorin.pe
# Same value as PANEL_API_SECRET in the backend. Generate it like OTP_SECRET.
PANEL_API_SECRET=
